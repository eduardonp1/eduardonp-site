---
const { uri, icon, color, margin = "0px 0px 0px 0px" } = Astro.props

const icons = import.meta.glob('../assets/icons/*.svg', { as: 'raw', eager: true });
const svgContent = icons[`../assets/icons/${icon}.svg`];
---

<a href={uri} target="_blank" rel="noopener noreferrer">
  <Fragment set:html={svgContent} />
</a>

<style define:vars={{color, margin}}>
  a {
    margin: 0;
    padding: 0;
  }
  a {
    display: flex;
    justify-content: center;
    align-items: center;
    width: 25px;
    height: 25px;
    margin: var(--margin);
    padding: 16px;
    color: #f1f1f1;
    background-color: var(--color);
    border-radius: 16px;
    text-decoration: dashed;
    transition: filter 0.3s ease;
  }
  a:hover {
    filter: brightness(0.8);
  }
  a :global(svg) {
    width: 20px;
    height: 20px;
  }
</style>
