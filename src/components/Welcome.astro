---
import astroLogo from '../assets/astro.svg';
import background from '../assets/background.svg';
import avatar from '../assets/avatar.png';
import '../styles/global.css'
import SocialButton from './SocialButton.astro';
---

<div id="container" class="google-sans-flex">
	<span id="backround-color"/>
	<img id="background" src={background.src} alt="degradado de fondo" fetchpriority="high" />
	<div id="info">
		<div>
			<h1 class="julius-sans-one-regular">Eduardo <br>Nolasco P.</h1>
			<p>Desarrollador móvil / Desarrollador back-end</p>
			<div id="socials-button">
				<SocialButton margin = "0 16px 16px 0" uri="https://www.linkedin.com/in/eduardo-nolasco-666b86151" icon="hgi-linkedin-02hgi hgi-duotone hgi-linkedin-02" color="#165cb1"/>
				<SocialButton margin = "0 16px 16px 0" uri="https://github.com/eduardonp1" icon="hgi hgi-duotone hgi-github" color="#5c5e60"/>
				<SocialButton margin = "0 16px 16px 0" uri="https://x.com/lalonolasc" icon="hgi hgi-duotone hgi-new-twitter" color="#060809"/>
				<div id="mail-button">
					<SocialButton margin = "0 16px 0 0" uri="mailto:mail@eduardonp.com" icon="hgi hgi-duotone hgi-mail-01" color="#00776c"/>
					<p class="google-sans-flex-v1">mail@eduardonp.com</p>
				</div>
			</div>
		</div>
	</div>
	<div id="image"><img id="avatar" src={avatar.src} alt="Foto de perfil"></div>
</div>

<style>
	#backround-color {
		position: fixed;
		top: 0;
		left: 0;
		width: 100%;
		height: 100%;
		z-index: -2;
		background-color: #101417;
	}
	#background {
		position: fixed;
		top: 0;
		left: 0;
		width: 100%;
		height: 100%;
		z-index: -1;
		filter: blur(100px);
		opacity: .45;
	}

	#container {
		color: #e5e5e5;
		height: 100%;
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		align-items: center;
		align-content: center;
	}

	#image {
		flex-grow: 1;
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		align-items: center;
		align-content: center;
	}

	#avatar {
		width: 30vw;
		height: auto;
	}

	#info {
		flex-grow: 1;
		display: flex;
		flex-wrap: nowrap;
		justify-content: center;
		align-items: center;
		align-content: center;
	}

	#info>div {
		width: fit-content;
	}

	h1 {
		font-size: 80px;
	}

	p {
		font-size: 1.5rem;
	}
	
	#socials-button {
		display: flex;
		flex-wrap: wrap;
		flex-direction: row;
		align-items: start;
	}

	#mail-button {
		display: flex;
		align-items: center;
		background-color: #00776b66;
		padding-right: 18px;
		border-radius: 16px;
		transition: background-color 0.3s ease, padding-right 0.3s ease;
	}

	#mail-button > p {
		font-size: 1rem;
	}

	@media (min-width: 1011px) {
		#mail-button {
			padding-right: 0;
			cursor: pointer;
		}

		#mail-button:hover {
			padding-right: 18px;
		}

		#mail-button > p {
			max-width: 0;
			opacity: 0;
			overflow: hidden;
			white-space: nowrap;
			transition: max-width 0.4s ease, opacity 0.3s ease;
		}

		#mail-button:hover > p {
			max-width: 300px;
			opacity: 1;
		}

		#mail-button :global(a) {
			margin-right: 0 !important;
			transition: margin-right 0.4s ease;
		}

		#mail-button:hover :global(a) {
			margin-right: 16px !important;
		}
	}


	@media (max-width: 1010px) {
		h1 {
			font-size: 50px;
		}

		#container {
			flex-direction: column-reverse;
		}

		#avatar {
			width: 65vw;
			flex-grow: 1;
		}

		#info {
			margin-left: 16px;
			margin-right: 16px;
			flex-grow: 2;
			align-items: start;
		}
	}
</style>
